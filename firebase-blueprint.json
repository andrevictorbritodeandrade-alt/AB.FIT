{
  "entities": {
    "Aluno": {
      "title": "Aluno",
      "description": "Perfil do aluno com dados pessoais e configurações.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "email_verified": { "type": "boolean" }
      },
      "required": ["id", "nome", "email"]
    },
    "Prescricao": {
      "title": "Prescricao",
      "description": "Uma prescrição de treino (ex: Treino A).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "totalSessoes": { "type": "number" },
        "ativo": { "type": "boolean" },
        "exercicios": { "type": "array" }
      },
      "required": ["nome", "totalSessoes"]
    },
    "LogTreino": {
      "title": "LogTreino",
      "description": "Registro de um treino executado na subcoleção do aluno.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "prescricaoId": { "type": "string" },
        "dataHora": { "type": "object", "description": "Firestore Timestamp" },
        "duracaoMinutos": { "type": "number" },
        "calorias": { "type": "number" },
        "cargas": { "type": "array", "description": "Lista de exercícios e suas cargas" },
        "concluido": { "type": "boolean" }
      },
      "required": ["prescricaoId", "dataHora", "concluido"]
    },
    "Workout": {
      "title": "Workout",
      "description": "Registro de treino na coleção global de workouts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "workoutId": { "type": "string" },
        "nome": { "type": "string" },
        "duracao": { "type": "string" },
        "concluidoEm": { "type": "object", "description": "Firestore serverTimestamp" }
      },
      "required": ["userId", "nome", "concluidoEm"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Contador atômico de progresso e sessões de treino.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "totalWorkouts": { "type": "number" },
        "lastWorkoutAt": { "type": "object", "description": "Firestore serverTimestamp" }
      },
      "required": ["totalWorkouts"]
    }
  },
  "firestore": {
    "/alunos/{alunoId}": {
      "schema": "Aluno",
      "description": "Documento principal do aluno."
    },
    "/alunos/{alunoId}/prescricoes/{prescricaoId}": {
      "schema": "Prescricao",
      "description": "Subcoleção de prescrições de treino."
    },
    "/alunos/{alunoId}/logsTreino/{logId}": {
      "schema": "LogTreino",
      "description": "Subcoleção de registros de treinos executados."
    },
    "/workouts/{workoutId}": {
      "schema": "Workout",
      "description": "Coleção global de treinos realizados com serverTimestamp."
    },
    "/userProgress/{userId}": {
      "schema": "UserProgress",
      "description": "Documentos de progresso atômico do usuário."
    }
  }
}
