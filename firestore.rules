rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras de acesso completo para leitura e gravação dos dados do app
    match /alunos/{alunoId} {
      allow read, write: if true;
      
      match /logsTreino/{logId} {
        allow read, write: if true;
      }
      
      match /prescricoes/{prescId} {
        allow read, write: if true;
      }
      
      match /biometria/{bioId} {
        allow read, write: if true;
      }
    }

    match /workouts/{workoutId} {
      allow read, write: if true;
    }

    match /userProgress/{userId} {
      allow read, write: if true;
    }

    match /artifacts/{document=**} {
      allow read, write: if true;
    }

    match /exercise_database/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
